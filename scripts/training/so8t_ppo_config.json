{
  "ppo": {
    "learning_rate": 1e-6,
    "max_steps": 1000,
    "batch_size": 1,
    "epochs": 1,
    "clip_epsilon": 0.2,
    "value_loss_coef": 0.5,
    "entropy_coef": 0.01,
    "max_grad_norm": 0.5,
    "warmup_steps": 100,
    "annealing_steps": 500,
    "save_steps": 100,
    "eval_steps": 50
  },
  "so8t": {
    "vector_weight": 0.3,
    "spinor_plus_weight": 0.4,
    "spinor_minus_weight": 0.3,
    "annealing_steps": 500,
    "chaos_factor": 0.1
  },
  "model": {
    "model_name": "Borea-Phi-3.5-mini-Instruct-Jp",
    "max_length": 2048,
    "trust_remote_code": true,
    "torch_dtype": "float16",
    "device_map": "auto",
    "load_in_8bit": true
  },
  "training": {
    "gradient_checkpointing": true,
    "use_cache": false,
    "output_dir": "outputs/so8t_ppo_training",
    "logging_steps": 10,
    "save_total_limit": 5,
    "evaluation_strategy": "steps",
    "save_strategy": "steps",
    "load_best_model_at_end": false,
    "metric_for_best_model": "reward"
  },
  "data": {
    "train_file": "data/integrated/so8t_integrated_ppo_dataset_main_20251201_205340.jsonl",
    "max_length": 2048,
    "preprocessing_num_workers": 4
  }
}




