# SO8T Project Environment Variables Example
# Copy this file to .env and fill in your actual values

# --- Hugging Face Configuration ---
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_TOKEN=your_huggingface_token_here
# ---GitHub Configuration---
GITHUB_TOKEN=your_github_token_here 
# ---Semantic Scholar Configuration---
API_KEY=
# --- AEGIS-v3.0 Pipeline Configuration ---
SO8T_USE_UNSLOTH=1
SO8T_DRYRUN=0
SO8T_HF_UPLOAD=1
SO8T_HF_INCLUDE_LARGE=0
SO8T_GRAPE_VARIANT=multiplicative
SO8T_RESEARCH_TOPIC="Advanced Mathematical Reasoning and SO8T Quadrality Optimization"
SO8T_RECOVER=0
SO8T_TRAINING_CONFIG="src/infrastructure/config/borea_training.json"

# --- Model & Path Configuration ---
MODEL_PATH=models/Borea-Phi-3.5-mini-Instruct-Jp
CHECKPOINT_DIR=H:/from_D/webdataset/checkpoints/aegis_v2_ppo

# --- AI & Execution Configuration ---
OLLAMA_MODEL=aegis-v2:latest
LLAMA_CPP_MODEL_PATH=models/aegis_v2_hf_export/

# --- Training Hyperparameters ---
MAX_STEPS=200
EPOCHS=10
BATCH_SIZE=4
LEARNING_RATE=5e-6

# --- GPU & Hardware Configuration ---
CUDA_VISIBLE_DEVICES=0
PYTORCH_ALLOC_CONF=max_split_size_mb:512

# --- Logging & Debugging ---
LOG_LEVEL=INFO
LOG_FILE=logs/aegis_v2_ppo_training.log

# --- Optional Feature Flags ---
DISABLE_UNSLOTH=0
DISABLE_BITANDBYTES=0
